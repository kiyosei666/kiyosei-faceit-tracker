diff --git a/migrations/001_baseline.sql b/migrations/001_baseline.sql
new file mode 100644
index 0000000..0686b67
--- /dev/null
+++ b/migrations/001_baseline.sql
@@ -0,0 +1,19 @@
+-- Baseline: mirrors the tables the app already created at runtime.
+-- Idempotent on purpose so existing Supabase data is untouched.
+CREATE TABLE IF NOT EXISTS elo_snapshots (
+  id BIGSERIAL PRIMARY KEY,
+  elo INTEGER NOT NULL,
+  captured_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE IF NOT EXISTS faceit_matches (
+  match_id TEXT PRIMARY KEY,
+  finished_at BIGINT,
+  map TEXT,
+  outcome TEXT,
+  score TEXT,
+  stats JSONB,
+  elo_before INTEGER,
+  elo_after INTEGER,
+  elo_change INTEGER,
+  saved_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
diff --git a/migrations/002_sync_tables.sql b/migrations/002_sync_tables.sql
new file mode 100644
index 0000000..ee4bf07
--- /dev/null
+++ b/migrations/002_sync_tables.sql
@@ -0,0 +1,19 @@
+-- Additive only: new tables plus nullable columns. Nothing is dropped or rewritten.
+CREATE TABLE IF NOT EXISTS sync_state (
+  key TEXT PRIMARY KEY,
+  value JSONB NOT NULL DEFAULT '{}'::jsonb,
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE IF NOT EXISTS sync_runs (
+  id BIGSERIAL PRIMARY KEY,
+  kind TEXT NOT NULL,
+  status TEXT NOT NULL DEFAULT 'running',
+  started_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  finished_at TIMESTAMPTZ,
+  matches_seen INTEGER NOT NULL DEFAULT 0,
+  matches_saved INTEGER NOT NULL DEFAULT 0,
+  error TEXT
+);
+CREATE INDEX IF NOT EXISTS sync_runs_started_idx ON sync_runs (started_at DESC);
+ALTER TABLE faceit_matches ADD COLUMN IF NOT EXISTS source TEXT;
+ALTER TABLE faceit_matches ADD COLUMN IF NOT EXISTS started_at BIGINT;
