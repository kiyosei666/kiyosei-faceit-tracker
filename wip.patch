diff --git a/src/db.js b/src/db.js
new file mode 100644
index 0000000..9cbbb39
--- /dev/null
+++ b/src/db.js
@@ -0,0 +1,70 @@
+const fs = require("fs");
+const path = require("path");
+const { Pool } = require("pg");
+
+// SSL stays on by default (matches the previous behaviour for Supabase).
+// Set DATABASE_SSL=disable only for a local test database.
+const pool = process.env.DATABASE_URL
+  ? new Pool({
+      connectionString: process.env.DATABASE_URL,
+      ssl: process.env.DATABASE_SSL === "disable" ? false : { rejectUnauthorized: false },
+      max: 5,
+      idleTimeoutMillis: 30000,
+      connectionTimeoutMillis: 10000
+    })
+  : null;
+
+if (pool) {
+  pool.on("error", (error) => console.error("Unexpected database pool error:", error.message));
+}
+
+const MIGRATIONS_DIR = path.join(__dirname, "..", "migrations");
+let migrationPromise = null;
+
+// Applies numbered .sql files once each, in order. Additive only: files are
+// never edited after release, and nothing here drops or rewrites data.
+async function runMigrations() {
+  if (!pool) return false;
+  const client = await pool.connect();
+  try {
+    await client.query("SELECT pg_advisory_lock(727001)");
+    await client.query(
+      "CREATE TABLE IF NOT EXISTS schema_migrations (name TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW())"
+    );
+    const done = new Set((await client.query("SELECT name FROM schema_migrations")).rows.map((r) => r.name));
+    const files = fs.readdirSync(MIGRATIONS_DIR).filter((f) => f.endsWith(".sql")).sort();
+    for (const file of files) {
+      if (done.has(file)) continue;
+      const sql = fs.readFileSync(path.join(MIGRATIONS_DIR, file), "utf8");
+      try {
+        await client.query("BEGIN");
+        await client.query(sql);
+        await client.query("INSERT INTO schema_migrations (name) VALUES ($1)", [file]);
+        await client.query("COMMIT");
+        console.log(`Applied migration ${file}`);
+      } catch (error) {
+        await client.query("ROLLBACK");
+        throw new Error(`Migration ${file} failed: ${error.message}`);
+      }
+    }
+    return true;
+  } finally {
+    await client.query("SELECT pg_advisory_unlock(727001)").catch(() => {});
+    client.release();
+  }
+}
+
+// Same contract as the old ensureSchema(): false when no database is
+// configured, true once the schema is ready. Retries after a failure.
+function ensureSchema() {
+  if (!pool) return Promise.resolve(false);
+  if (!migrationPromise) {
+    migrationPromise = runMigrations().catch((error) => {
+      migrationPromise = null;
+      throw error;
+    });
+  }
+  return migrationPromise;
+}
+
+module.exports = { pool, ensureSchema, runMigrations };
diff --git a/src/faceit.js b/src/faceit.js
new file mode 100644
index 0000000..4b36a24
--- /dev/null
+++ b/src/faceit.js
@@ -0,0 +1,71 @@
+const API_BASE = process.env.FACEIT_API_BASE || "https://open.faceit.com/data/v4";
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+function friendlyMessage(status) {
+  return status === 401 ? "FACEIT rejected the API key."
+    : status === 403 ? "FACEIT denied access to this API resource."
+    : status === 429 ? "FACEIT rate limit reached. Try again shortly."
+    : `FACEIT API returned HTTP ${status}.`;
+}
+
+// Retries only transient failures (429, 5xx, network errors) with
+// exponential backoff. 4xx errors such as 401/403/404 fail immediately.
+async function faceitGet(endpoint, { retries = 3, baseDelayMs = 800 } = {}) {
+  if (!process.env.FACEIT_API_KEY) {
+    const error = new Error("FACEIT_API_KEY is not configured on the server.");
+    error.status = 503;
+    throw error;
+  }
+  let lastError;
+  for (let attempt = 0; attempt <= retries; attempt++) {
+    try {
+      const response = await fetch(`${API_BASE}${endpoint}`, {
+        headers: { Authorization: `Bearer ${process.env.FACEIT_API_KEY}`, Accept: "application/json" }
+      });
+      if (response.ok) return await response.json();
+      const error = new Error(friendlyMessage(response.status));
+      error.status = response.status;
+      if (response.status !== 429 && response.status < 500) throw error;
+      const retryAfter = Number(response.headers.get("retry-after"));
+      error.retryAfterMs = Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : null;
+      lastError = error;
+    } catch (error) {
+      if (error.status && error.status < 500 && error.status !== 429) throw error;
+      lastError = error;
+    }
+    if (attempt < retries) {
+      await sleep(lastError.retryAfterMs ?? baseDelayMs * 2 ** attempt);
+    }
+  }
+  throw lastError;
+}
+
+function getPlayerOutcome(match, playerId) {
+  const winner = match.results?.winner;
+  for (const [teamName, team] of Object.entries(match.teams || {})) {
+    if ((team.roster || []).some((member) => member.player_id === playerId)) {
+      return winner ? (winner === teamName ? "Win" : "Loss") : "Unknown";
+    }
+  }
+  return "Unknown";
+}
+
+function getPlayerMatchStats(data, playerId, nickname) {
+  const round = data?.rounds?.[0];
+  if (!round) return { stats: null, map: null, score: null };
+  let found = null;
+  for (const team of round.teams || []) {
+    found = (team.players || []).find((player) =>
+      player.player_id === playerId || player.nickname?.toLowerCase() === nickname.toLowerCase()
+    );
+    if (found) break;
+  }
+  const score = (round.teams || []).map((team) => team.team_stats?.["Final Score"]).filter(Boolean).join("-");
+  return {
+    stats: found?.player_stats || null,
+    map: round.round_stats?.Map || null,
+    score: score || null
+  };
+}
+
+module.exports = { faceitGet, getPlayerOutcome, getPlayerMatchStats };
diff --git a/src/sync.js b/src/sync.js
new file mode 100644
index 0000000..3b31e73
--- /dev/null
+++ b/src/sync.js
@@ -0,0 +1,149 @@
+const { pool, ensureSchema } = require("./db");
+const { faceitGet, getPlayerOutcome, getPlayerMatchStats } = require("./faceit");
+const { persistMatches } = require("./tracker");
+
+const NICKNAME = () => process.env.FACEIT_NICKNAME || "kiyosei";
+const GAME = "cs2";
+const PAGE_SIZE = 100; // documented FACEIT maximum per history request
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const LOCK_KEY = 727002;
+
+async function getState(key) {
+  const r = await pool.query("SELECT value FROM sync_state WHERE key = $1", [key]);
+  return r.rows[0]?.value || null;
+}
+async function setState(key, value) {
+  await pool.query(
+    `INSERT INTO sync_state (key, value, updated_at) VALUES ($1, $2, NOW())
+     ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = NOW()`,
+    [key, JSON.stringify(value)]
+  );
+}
+
+// Only one sync/import runs at a time (cron overlap, double clicks, etc.).
+async function withLock(fn) {
+  const client = await pool.connect();
+  try {
+    const got = (await client.query("SELECT pg_try_advisory_lock($1) AS ok", [LOCK_KEY])).rows[0].ok;
+    if (!got) { const e = new Error("Another sync is already running."); e.status = 409; throw e; }
+    try { return await fn(); }
+    finally { await client.query("SELECT pg_advisory_unlock($1)", [LOCK_KEY]).catch(() => {}); }
+  } finally { client.release(); }
+}
+
+async function startRun(kind) {
+  const r = await pool.query("INSERT INTO sync_runs (kind) VALUES ($1) RETURNING id", [kind]);
+  return r.rows[0].id;
+}
+async function finishRun(id, status, seen, saved, error) {
+  await pool.query(
+    "UPDATE sync_runs SET status=$2, finished_at=NOW(), matches_seen=$3, matches_saved=$4, error=$5 WHERE id=$1",
+    [id, status, seen, saved, error ? String(error).slice(0, 500) : null]
+  );
+}
+
+async function loadPlayer() {
+  const player = await faceitGet(`/players?nickname=${encodeURIComponent(NICKNAME())}&game=${GAME}`);
+  if (!player.player_id) throw new Error("FACEIT did not return a player ID for this nickname.");
+  return player;
+}
+
+// Incremental sync: newest 100 matches (was 20), deduplicated by match_id.
+async function syncRecent() {
+  if (!(await ensureSchema())) { const e = new Error("Database is not configured."); e.status = 503; throw e; }
+  return withLock(async () => {
+    const runId = await startRun("recent");
+    let seen = 0, saved = 0;
+    try {
+      const player = await loadPlayer();
+      const history = await faceitGet(`/players/${player.player_id}/history?game=${GAME}&offset=0&limit=${PAGE_SIZE}`);
+      const game = player.games?.[GAME] || {};
+      seen = (history.items || []).length;
+      const result = await persistMatches(history.items || [], player.player_id, player.nickname || NICKNAME(), game.faceit_elo);
+      saved = result.saved;
+      await finishRun(runId, "ok", seen, saved, null);
+      await setState("last_success", { at: new Date().toISOString(), kind: "recent", seen, saved });
+      return { ok: true, seen, saved };
+    } catch (error) {
+      await finishRun(runId, "error", seen, saved, error.message);
+      throw error;
+    }
+  });
+}
+
+// Resumable career import. Walks backwards in time using the `to` timestamp
+// cursor (count offsets are unreliable beyond ~1000). The cursor is saved
+// after every page, so an interrupted run continues where it stopped.
+// Imported rows have NULL ELO fields: FACEIT's official API gives no per-match ELO.
+async function importCareer({ maxPages = 5, delayMs = 250 } = {}) {
+  if (!(await ensureSchema())) { const e = new Error("Database is not configured."); e.status = 503; throw e; }
+  return withLock(async () => {
+    const runId = await startRun("career_import");
+    let seen = 0, saved = 0;
+    try {
+      const player = await loadPlayer();
+      const nickname = player.nickname || NICKNAME();
+      const state = (await getState("career_import")) || { done: false, cursor: null, pages: 0, imported: 0 };
+      if (state.done) { await finishRun(runId, "ok", 0, 0, null); return { ok: true, done: true, seen: 0, saved: 0, state }; }
+
+      for (let page = 0; page < maxPages; page++) {
+        const q = `/players/${player.player_id}/history?game=${GAME}&limit=${PAGE_SIZE}` +
+          (state.cursor ? `&to=${state.cursor}` : "&offset=0");
+        const history = await faceitGet(q);
+        const items = history.items || [];
+        if (!items.length) { state.done = true; await setState("career_import", state); break; }
+        seen += items.length;
+        const savedBefore = saved;
+
+        const known = new Set((await pool.query(
+          "SELECT match_id FROM faceit_matches WHERE match_id = ANY($1)", [items.map((i) => i.match_id)]
+        )).rows.map((r) => r.match_id));
+
+        for (const item of items) {
+          if (!item.match_id || known.has(item.match_id)) continue;
+          let stats = null, map = item.map || item.competition_name || "FACEIT match", score = null;
+          try {
+            const parsed = getPlayerMatchStats(await faceitGet(`/matches/${encodeURIComponent(item.match_id)}/stats`), player.player_id, nickname);
+            stats = parsed.stats; map = parsed.map || map; score = parsed.score;
+          } catch (error) {
+            console.warn(`Import: no stats for ${item.match_id}: ${error.message}`);
+          }
+          const r = await pool.query(
+            `INSERT INTO faceit_matches (match_id, finished_at, started_at, map, outcome, score, stats, source)
+             VALUES ($1,$2,$3,$4,$5,$6,$7,'career_import') ON CONFLICT (match_id) DO NOTHING`,
+            [item.match_id, item.finished_at || null, item.started_at || null, map,
+             getPlayerOutcome(item, player.player_id), score, stats ? JSON.stringify(stats) : null]
+          );
+          saved += r.rowCount;
+          await sleep(delayMs);
+        }
+
+        const oldest = Math.min(...items.map((i) => Number(i.started_at || i.finished_at)).filter(Number.isFinite));
+        state.pages += 1; state.imported += saved - savedBefore;
+        // Stop if the cursor can't move backwards (guards against loops).
+        if (!Number.isFinite(oldest) || (state.cursor && oldest >= Number(state.cursor))) { state.done = true; await setState("career_import", state); break; }
+        state.cursor = oldest;
+        if (items.length < PAGE_SIZE) state.done = true;
+        await setState("career_import", state);
+        if (state.done) break;
+      }
+      await finishRun(runId, "ok", seen, saved, null);
+      return { ok: true, done: Boolean(state.done), seen, saved, state };
+    } catch (error) {
+      await finishRun(runId, "error", seen, saved, error.message);
+      throw error;
+    }
+  });
+}
+
+async function syncStatus() {
+  if (!(await ensureSchema())) return { configured: false };
+  const [runs, last, career, counts] = await Promise.all([
+    pool.query("SELECT id, kind, status, started_at, finished_at, matches_seen, matches_saved, error FROM sync_runs ORDER BY started_at DESC, id DESC LIMIT 10"),
+    getState("last_success"), getState("career_import"),
+    pool.query("SELECT COUNT(*)::int AS total, COUNT(*) FILTER (WHERE source = 'career_import')::int AS imported FROM faceit_matches")
+  ]);
+  return { configured: true, lastSuccess: last, careerImport: career, matches: counts.rows[0], recentRuns: runs.rows };
+}
+
+module.exports = { syncRecent, importCareer, syncStatus };
diff --git a/src/tracker.js b/src/tracker.js
new file mode 100644
index 0000000..0d5d8aa
--- /dev/null
+++ b/src/tracker.js
@@ -0,0 +1,88 @@
+const { pool, ensureSchema } = require("./db");
+const { faceitGet, getPlayerOutcome, getPlayerMatchStats } = require("./faceit");
+
+// The 1,680 comeback baseline. Inserted once as the first snapshot and never
+// updated or deleted by any code path.
+const BASELINE_ELO = 1680;
+const BASELINE_AT = "2026-11-11T00:00:00+08:00";
+
+async function persistMatches(historyItems, playerId, nickname, currentElo) {
+  if (!(await ensureSchema())) return { configured: false, saved: 0 };
+  const latestSnapshot = await pool.query(
+    "SELECT elo FROM elo_snapshots ORDER BY captured_at DESC, id DESC LIMIT 1"
+  );
+  let previousElo = latestSnapshot.rows[0]?.elo ?? null;
+  const isFirstSync = previousElo === null;
+
+  if (isFirstSync) {
+    await pool.query(
+      "INSERT INTO elo_snapshots (elo, captured_at) VALUES ($1, $2)",
+      [BASELINE_ELO, BASELINE_AT]
+    );
+    previousElo = BASELINE_ELO;
+  }
+
+  const known = await pool.query("SELECT match_id FROM faceit_matches");
+  const knownIds = new Set(known.rows.map((row) => row.match_id));
+  const newItems = (historyItems || []).filter((item) => item.match_id && !knownIds.has(item.match_id));
+  const chronological = [...newItems].reverse();
+  let saved = 0;
+
+  for (let index = 0; index < chronological.length; index++) {
+    const match = chronological[index];
+    let matchStats = null;
+    let matchMap = match.map || match.competition_name || "FACEIT match";
+    let score = null;
+
+    try {
+      const statsData = await faceitGet(`/matches/${encodeURIComponent(match.match_id)}/stats`);
+      const parsed = getPlayerMatchStats(statsData, playerId, nickname);
+      matchStats = parsed.stats;
+      matchMap = parsed.map || matchMap;
+      score = parsed.score;
+    } catch (error) {
+      console.warn(`Could not fetch stats for match ${match.match_id}: ${error.message}`);
+    }
+
+    // FACEIT's public player-history response does not expose a dependable
+    // per-match ELO delta. Attribute a delta only when exactly one new match
+    // appeared between two known ELO snapshots.
+    const canAttributeElo = !isFirstSync && chronological.length === 1 && Number.isFinite(Number(currentElo));
+    const eloBefore = canAttributeElo ? previousElo : null;
+    const eloAfter = canAttributeElo ? Number(currentElo) : null;
+    const eloChange = canAttributeElo ? Number(currentElo) - previousElo : null;
+
+    await pool.query(
+      `INSERT INTO faceit_matches
+        (match_id, finished_at, map, outcome, score, stats, elo_before, elo_after, elo_change)
+       VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)
+       ON CONFLICT (match_id) DO NOTHING`,
+      [match.match_id, match.finished_at || match.started_at || null, matchMap,
+       getPlayerOutcome(match, playerId), score, matchStats ? JSON.stringify(matchStats) : null,
+       eloBefore, eloAfter, eloChange]
+    );
+    saved++;
+  }
+
+  const current = Number(currentElo);
+  if (Number.isFinite(current)) {
+    const last = await pool.query(
+      "SELECT elo FROM elo_snapshots ORDER BY captured_at DESC, id DESC LIMIT 1"
+    );
+    if (!last.rows.length || last.rows[0].elo !== current) {
+      await pool.query("INSERT INTO elo_snapshots (elo) VALUES ($1)", [current]);
+    }
+  }
+  return { configured: true, saved, firstSync: isFirstSync };
+}
+
+async function readTrackingData() {
+  if (!(await ensureSchema())) return { configured: false, snapshots: [], matches: [] };
+  const [snapshots, matches] = await Promise.all([
+    pool.query("SELECT elo, captured_at FROM elo_snapshots ORDER BY captured_at ASC"),
+    pool.query("SELECT match_id, finished_at, map, outcome, score, stats, elo_before, elo_after, elo_change FROM faceit_matches ORDER BY finished_at DESC NULLS LAST LIMIT 50")
+  ]);
+  return { configured: true, snapshots: snapshots.rows, matches: matches.rows };
+}
+
+module.exports = { persistMatches, readTrackingData, BASELINE_ELO, BASELINE_AT };
