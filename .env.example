FACEIT_API_KEY=your_server_side_faceit_api_key
FACEIT_NICKNAME=kiyosei
PORT=3000

# AI coach (optional). Server-side only; never expose in frontend code.
GEMINI_API_KEY=your_server_side_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash
# COACH_DAILY_LIMIT=20
# COACH_MIN_INTERVAL_MIN=60
# COACH_MATCH_RECENT_LIMIT=5

# Live match detection (webhook receiver). Generate a long random value, e.g.: openssl rand -hex 32
FACEIT_WEBHOOK_SECRET=your_random_webhook_secret
# Optional: skip the player lookup by pinning your FACEIT player GUID
# FACEIT_PLAYER_ID=
# Optional: GET /matches/{id} status strings that mean "match in progress" (default ONGOING = unverified candidate)
# FACEIT_INGAME_STATUSES=ONGOING
# LIVE_POLL_INTERVAL_SECONDS=45   (30-120)
# LIVE_MAX_MATCH_MINUTES=360
